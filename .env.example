SEED_ADMIN_PASSWORD=UNT.Administracion@2026
SEED_STUDENT_EMAIL=alumno.demo@unitru.edu.pe
SEED_STUDENT_PASSWORD=UNT.Estudiante@2026
SEED_TEACHER_EMAIL=profesor.demo@unitru.edu.pe
SEED_TEACHER_PASSWORD=UNT.Docencia@2026
SEED_COMPANY_EMAIL=empresa.demo@unitru.edu.pe
SEED_COMPANY_PASSWORD=UNT.Empresa@2026
